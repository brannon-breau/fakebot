# From the Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token

# Optional: set this while testing to register commands instantly to one server
# instead of globally (global registration can take up to an hour to appear).
GUILD_ID=

# n8n Webhook node URL that will receive the slash command payload
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/discord-slash
